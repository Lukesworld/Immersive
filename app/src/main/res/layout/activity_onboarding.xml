<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/immersive_obsidian_bg"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/cd_app_logo"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/onboarding_title"
            android:textColor="@color/immersive_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/onboarding_subtitle"
            android:textColor="@color/immersive_text_secondary"
            android:textSize="16sp" />

        <!-- Play Store Mandatory Prominent Disclosure Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_disclosure_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/disclosure_heading"
                android:textColor="@color/immersive_emerald_bright"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/disclosure_body"
                android:textColor="@color/immersive_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnAcceptAndEnable"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:text="@string/btn_enable_accessibility"
            android:textAllCaps="false"
            android:textColor="@color/immersive_obsidian_bg"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDecline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_secondary"
            android:stateListAnimator="@null"
            android:text="@string/btn_not_now"
            android:textAllCaps="false"
            android:textColor="@color/immersive_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
